{
  "name": "claimflow",
  "version": "0.2.0",
  "private": true,
  "description": "Employee expense and reimbursement management",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/domain",
    "packages/contracts",
    "services/api",
    "apps/web",
    "infrastructure"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta --kill-others-on-fail \"npm run dev -w @claimflow/api\" \"npm run dev -w @claimflow/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @claimflow/api",
    "reset-data": "npm run reset-data -w @claimflow/api",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
